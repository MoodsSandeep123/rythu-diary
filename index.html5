<!DOCTYPE html>
<html lang="te">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>రైతు డైరీ – Rythu Diary</title>
<style>
:root{--bg:#f4f7ef;--card:#fff;--tx:#1d2b1a;--mu:#5d6b58;--pr:#2e7d32;--pt:#fff;--bd:#dde5d3;--rd:#c62828;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#121a11;--card:#1c271b;--tx:#e8f0e4;--mu:#9bab95;--pr:#66bb6a;--pt:#10200f;--bd:#2c3b2a;--rd:#ef5350}}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--tx);font-family:system-ui,-apple-system,"Noto Sans Telugu",sans-serif;font-size:16px}
.w{max-width:640px;margin:0 auto;padding:14px 14px 80px}
h1{font-size:22px;margin:6px 0}h2{font-size:18px;margin:0 0 8px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:12px;margin:10px 0}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.sp{justify-content:space-between}
button{font:inherit;border:0;border-radius:10px;padding:10px 14px;background:var(--pr);color:var(--pt);font-weight:600;cursor:pointer}
button.g{background:transparent;color:var(--pr);border:1px solid var(--bd)}button.d{background:transparent;color:var(--rd);padding:4px 8px;font-weight:400}
input,select,textarea{font:inherit;width:100%;padding:10px;border-radius:10px;border:1px solid var(--bd);background:var(--bg);color:var(--tx);margin:3px 0 8px}
label{font-size:13px;color:var(--mu)}
.mu{color:var(--mu);font-size:13px}.b{display:inline-block;background:var(--bg);border:1px solid var(--bd);border-radius:20px;padding:2px 10px;font-size:12px}
.st{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.st div{background:var(--bg);border-radius:10px;padding:8px;text-align:center}.st b{display:block;font-size:17px}
.tl{border-left:3px solid var(--pr);margin-left:6px;padding-left:12px}
.it{margin:0 0 14px;position:relative}.it:before{content:"";position:absolute;left:-19px;top:6px;width:11px;height:11px;border-radius:50%;background:var(--pr)}
img.t{width:84px;height:84px;object-fit:cover;border-radius:10px;margin:6px 6px 0 0;cursor:pointer;border:1px solid var(--bd)}
.m{position:fixed;inset:0;background:rgba(0,0,0,.55);display:flex;align-items:flex-end;justify-content:center;z-index:9}
.m>div{background:var(--card);width:100%;max-width:640px;max-height:92%;overflow:auto;border-radius:18px 18px 0 0;padding:16px}
.fab{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));border-radius:30px;padding:14px 20px;box-shadow:0 4px 14px rgba(0,0,0,.3)}
.av{width:56px;height:56px;border-radius:50%;object-fit:cover;border:1px solid var(--bd);background:var(--bg);flex:none}
.sm .av{width:44px;height:44px;font-size:22px!important}
td{padding:6px 4px;border-bottom:1px solid var(--bd)}
.fl{border:1px solid var(--bd);background:var(--bg);padding:4px 8px;border-radius:8px;margin:2px;font-size:12px;display:inline-block}
</style>
</head>
<body>
<div class="w" id="app"></div>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<script>
const K='rythu_diary_v1';
const TYPES={spray:'🧪 పిచికారీ / మందు (Spray)',fert:'🌱 ఎరువు (Fertilizer)',growth:'📷 ఎదుగుదల ఫోటో (Growth)',replant:'🌿 మళ్లీ నాటడం (Replanting)',expense:'💰 ఖర్చు (Expense)',harvest:'🧺 దిగుబడి / ఆదాయం (Harvest)',note:'📝 నోట్ (Note)'};
const EXP=['డ్రిప్ పైపు (Drip pipe)','మల్చింగ్ పేపర్ (Mulching)','ట్రాక్టర్ దున్నడం (Tractor)','కూలీలు (Labour)','విత్తనం (Seed)','ఇతర (Other)'];
const CROPS=['ఎర్ర మిరప (Red Chilli)','పత్తి (Cotton)','వరి (Paddy)','మొక్కజొన్న (Maize)','టమాటా (Tomato)','వేరుశనగ (Groundnut)','కంది (Redgram)','ఇతర (Other)'];
let S=load(),cur=null,tab='t';
function load(){try{return JSON.parse(localStorage.getItem(K))||{user:null,crops:[]}}catch(e){return{user:null,crops:[]}}}
function save(){push();try{localStorage.setItem(K,JSON.stringify(S))}catch(e){alert('Storage నిండింది – Backup తీసుకొని పాత ఫోటోలు తీసేయండి')}}
const $=s=>document.querySelector(s);
const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const today=()=>new Date().toISOString().slice(0,10);
const days=d=>Math.max(0,Math.floor((Date.now()-new Date(d).getTime())/864e5));
const rs=n=>'₹'+(Number(n)||0).toLocaleString('en-IN');
const fd=d=>new Date(d).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'});
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const D=[["విత్తిన తేదీ","Sown on"],["పిచికారీ / మందు (Spray)", "Spray / Medicine"], ["ఎరువు (Fertilizer)", "Fertilizer"], ["ఎదుగుదల ఫోటో (Growth)", "Growth photo"], ["మళ్లీ నాటడం (Replanting)", "Replanting"], ["ఖర్చు (Expense)", "Expense"], ["దిగుబడి / ఆదాయం (Harvest)", "Harvest / Income"], ["నోట్ (Note)", "Note"], ["డ్రిప్ పైపు (Drip pipe)", "Drip pipe"], ["మల్చింగ్ పేపర్ (Mulching)", "Mulching paper"], ["ట్రాక్టర్ దున్నడం (Tractor)", "Tractor ploughing"], ["కూలీలు (Labour)", "Labour"], ["విత్తనం (Seed)", "Seed"], ["ఇతర (Other)", "Other"], ["ఎర్ర మిరప (Red Chilli)", "Red Chilli"], ["పత్తి (Cotton)", "Cotton"], ["వరి (Paddy)", "Paddy"], ["మొక్కజొన్న (Maize)", "Maize"], ["టమాటా (Tomato)", "Tomato"], ["వేరుశనగ (Groundnut)", "Groundnut"], ["కంది (Redgram)", "Redgram"], ["రైతు డైరీ · వెర్షన్", "Rythu Diary · Version"], ["రైతు డైరీ", "Rythu Diary"], ["రైతు ప్రొఫైల్", "Farmer profile"], ["రైతు", "Farmer"], ["మొబైల్ నంబర్ తో లాగిన్", "Login with mobile number"], ["మొబైల్ నంబర్ (+91)", "Mobile number (+91)"], ["మొబైల్ నంబర్ 10 అంకెలు ఇవ్వండి", "Enter a 10-digit mobile number"], ["మొబైల్ నంబర్", "Mobile number"], ["10 అంకెల నంబర్", "10-digit number"], ["OTP పంపండి", "Send OTP"], ["SMS లో వచ్చిన OTP", "OTP received by SMS"], ["Google తో Login", "Login with Google"], ["Google login కాలేదు: ", "Google login failed: "], ["Firebase ఇంకా కనెక్ట్ చేయలేదు. అప్పటివరకు ఈ ఫోన్ లో మాత్రమే వాడండి (Backup బటన్ తో ఫైల్ దాచుకోండి).", "Firebase is not connected yet. Until then, use this phone only (save a file using Backup in the menu)."], ["క్లౌడ్ లాగిన్: claude.ai లో లాగిన్ అయి ఈ లింక్ ఓపెన్ చేయండి. కొన్ని సెకన్లు వేచి ఉండండి…", "Cloud login: log in to claude.ai and open this link. Please wait a few seconds…"], ["లేదా ఈ ఫోన్ లో మాత్రమే వాడండి (క్లౌడ్ బ్యాకప్ ఉండదు).", "Or use this phone only (no cloud backup)."], ["ఈ ఫోన్ లో మాత్రమే వాడండి", "Use this phone only"], ["ఈ ఫోన్ లో మాత్రమే", "This phone only"], ["మీ పేరు", "Your name"], ["సరైన 10 అంకెల నంబర్ ఇవ్వండి", "Enter a valid 10-digit number"], ["OTP పంపాం", "OTP sent"], ["OTP పంపలేకపోయాం: ", "Could not send OTP: "], ["OTP తప్పు", "Wrong OTP"], ["సేవ్ అవుతోంది…", "Saving…"], ["క్లౌడ్ లో సేవ్ అయింది", "Saved to cloud"], ["క్లౌడ్ సేవ్ కాలేదు", "Cloud save failed"], ["క్లౌడ్ స్టోరేజ్ నిండింది", "Cloud storage is full"], ["క్లౌడ్ కనెక్ట్ కాలేదు", "Cloud not connected"], ["క్లౌడ్ తో సింక్ అయింది", "Synced with cloud"], ["Storage నిండింది – Backup తీసుకొని పాత ఫోటోలు తీసేయండి", "Storage is full – take a Backup and remove old photos"], ["నా పంటలు", "My crops"], ["రోజుల తర్వాత", "days later"], ["రోజులు", "days"], ["రోజు", "Day"], ["విత్తిన తేదీ: ", "Sown on: "], ["నమోదులు లేవు", "No entries"], ["ఇంకా నమోదులు లేవు", "No entries yet"], ["నమోదులు", "entries"], ["ఇంకా పంట లేదు. కింద \"+ కొత్త పంట\" నొక్కండి. ఇప్పటికే వేసిన పంట అయితే అసలు విత్తిన తేదీ పెట్టండి – రోజులు ఆటోమేటిక్ గా లెక్కిస్తుంది.", "No crops yet. Tap \"+ New crop\" below. If the crop is already sown, enter the original sowing date – days are counted automatically."], ["కొత్త పంట / New Crop", "New crop"], ["కొత్త పంట", "New crop"], ["మీ ప్రొఫైల్ నింపండి", "Fill in your profile"], ["ఇక్కడ నొక్కి ఫోటో, పేరు, నంబర్ నింపండి", "Tap here to add photo, name and number"], ["ఫోటో (కెమెరా లేదా గ్యాలరీ నుండి)", "Photo (camera or gallery)"], ["WhatsApp నంబర్ (వేరే అయితే)", "WhatsApp number (if different)"], ["ఊరు / గ్రామం", "Village"], ["మండలం", "Mandal"], ["జిల్లా", "District"], ["పేరు ఇవ్వండి", "Please enter your name"], ["పేరు", "Name"], ["మెనూ", "Menu"], ["నా ప్రొఫైల్", "My profile"], ["ప్రొఫైల్", "Profile"], ["డౌన్లోడ్", "Download"], ["Restore (ఫైల్ నుండి)", "Restore (from file)"], ["అయింది", "done"], ["ఫైల్ సరైనది కాదు", "Invalid file"], ["Logout చేయాలా? మీ డేటా క్లౌడ్ లో సురక్షితంగా ఉంటుంది, మళ్లీ లాగిన్ అయితే తిరిగి వస్తుంది.", "Log out? Your data stays safe in the cloud and returns when you log in again."], ["Logout చేయాలా? (డేటా ఈ ఫోన్ లో ఉంటుంది)", "Log out? (Data stays on this phone)"], ["విత్తిన తేదీ (Sowing date) – పాత పంట అయితే అసలు తేదీ", "Sowing date – for an old crop, enter the original date"], ["ఇప్పటికి ", "So far "], ["విత్తనం కంపెనీ / రకం (గుర్తులేకపోతే ఖాళీ)", "Seed company / variety (leave blank if unknown)"], ["ఎన్ని ప్యాకెట్లు", "Number of packets"], ["విత్తనం మొత్తం ధర", "Total seed cost"], ["విత్తన ప్యాకెట్ ఫోటో", "Seed packet photo"], ["విత్తనం బిల్లు ఫోటో", "Seed bill photo"], ["పంట వివరాలు మార్చు", "Edit crop details"], ["వెనక్కి", "Back"], ["ఈ పంట మొత్తం తొలగించాలా?", "Delete this entire crop?"], ["పంట తొలగించు", "Delete crop"], ["లాభం", "Profit"], ["విత్తనం", "Seed"], ["వివరాలు లేవు", "No details"], ["ప్యాకెట్లు", "packets"], ["టైమ్‌లైన్", "Timeline"], ["నోట్స్ లేవు. ఉదా: \"ఈ మందు బాగా పనిచేసింది\", \"ఈ ఎరువు వద్దు\", \"వచ్చే ఏడాది ఇది చేయాలి\" – \"+ నోట్\" నొక్కి రాయండి.", "No notes yet. Example: \"This medicine worked well\", \"Do not use this fertilizer\", \"Do this earlier next year\" – tap \"+ Note\" to write."], ["నోట్స్", "Notes"], ["నోట్ మార్చు", "Edit note"], ["కొత్త నోట్", "New note"], ["నోట్ (ఏ మందు ఎందుకు వాడాం, ఫలితం, వచ్చే ఏడాది గుర్తుంచుకోవాల్సినవి)", "Note (which medicine and why, result, things to remember next year)"], ["నోట్", "Note"], ["శీర్షిక (ఉదా: మందు పేరు / విషయం)", "Title (e.g. medicine name / subject)"], ["ఫోటో (ఐచ్ఛికం)", "Photo (optional)"], ["ఏదైనా రాయండి", "Please write something"], ["తేదీ (పాత తేదీ కూడా పెట్టొచ్చు)", "Date (you can enter an older date)"], ["తేదీ", "Date"], ["అన్ని పనులు (వరుసగా)", "All activity (in order)"], ["అన్ని పనులు", "All activity"], ["రకాల వారీగా", "By type"], ["రకం", "Type"], ["సార్లు", "times"], ["మొత్తం", "Total"], ["వాడిన మందులు / ఎరువులు", "Medicines / fertilizers used"], ["ఇంకా లేవు", "None yet"], ["ఫలితం నమోదు చేయలేదు", "No result recorded"], ["సంఖ్య/పరిమాణం", "Quantity"], ["ఫలితం జోడించు", "Add result"], ["ఫలితం చూసిన తేదీ", "Date result was checked"], ["మందు ఫలితం", "Medicine result"], ["ఫలితం", "Result"], ["కొట్టిన తేదీ", "sprayed on"], ["తొలగించాలా?", "Delete?"], ["తొలగించు", "Delete"], ["మార్చు", "Edit"], ["ఎలా పనిచేసింది?", "How did it work?"], ["బాగా పనిచేసింది", "Worked well"], ["కొంచెం పనిచేసింది", "Worked a little"], ["పనిచేయలేదు", "Did not work"], ["పంటకు నష్టం అయింది", "Damaged the crop"], ["వివరాలు (తెగులు తగ్గిందా, ఎన్ని రోజుల్లో, వచ్చే సారి ఏం చేయాలి)", "Details (did the pest/disease reduce, in how many days, what to do next time)"], ["ఇప్పటి పంట ఫోటో", "Current crop photo"], ["వివరాలు", "Details"], ["కొత్త నమోదు", "New entry"], ["నమోదు మార్చు", "Edit entry"], ["నమోదు", "Entry"], ["మందు / వస్తువు పేరు", "Medicine / item name"], ["ఏ మొక్కలు కొన్నారు", "Which plants were bought"], ["ఎక్కడ అమ్మారు", "Where it was sold"], ["కంపెనీ", "Company"], ["ఎందుకు వాడాం / ఏ తెగులు కోసం / ఫలితం, నోట్స్", "Why used / for which pest or disease / result, notes"], ["పరిమాణం (ఎన్ని మొక్కలు / లీటర్లు / క్వింటాళ్లు)", "Quantity (plants / litres / quintals)"], ["ఆదాయం ₹ (అమ్మిన మొత్తం)", "Income ₹ (amount sold for)"], ["ఖర్చు", "Expense"], ["ఆదాయం", "Income"], ["మందు / బాటిల్ ఫోటో", "Medicine / bottle photo"], ["పంట / మొక్క ఫోటో (మందు కొట్టినప్పుడు పంట ఎలా ఉందో)", "Crop / plant photo (how the crop looked when sprayed)"], ["బిల్ ఫోటో", "Bill photo"], ["మందు", "Medicine"], ["పంట", "Crop"], ["ఫోటో", "Photo"]];D.sort((a,b)=>b[0].length-a[0].length);
let LANG='en';try{LANG=localStorage.getItem('rythu_lang')||'en'}catch(e){}
document.documentElement.lang=LANG;document.title=LANG==='en'?'Rythu Diary':'రైతు డైరీ – Rythu Diary';
const TE=/[\u0C00-\u0C7F]/;
function tr(s){if(LANG!=='en'||typeof s!=='string'||!TE.test(s))return s;for(const p of D){if(s.includes(p[0]))s=s.split(p[0]).join(p[1])}return s}
function trNode(n){if(LANG!=='en'||!n)return;if(n.nodeType===3){const v=n.nodeValue;if(TE.test(v)){const t=tr(v);if(t!==v)n.nodeValue=t}}else if(n.nodeType===1){if(n.tagName==='SCRIPT'||n.tagName==='STYLE')return;if(n.placeholder&&TE.test(n.placeholder))n.placeholder=tr(n.placeholder);n.childNodes.forEach(trNode)}}
new MutationObserver(ms=>{ms.forEach(m=>{if(m.type==='characterData')trNode(m.target);else m.addedNodes.forEach(trNode)})}).observe(document.body,{childList:true,subtree:true,characterData:true});
const _al=window.alert.bind(window),_cf=window.confirm.bind(window);window.alert=m=>_al(tr(m));window.confirm=m=>_cf(tr(m));
function langBar(){return `<div class="row" style="justify-content:flex-end;margin-bottom:6px">🌐 <button class="${LANG==='en'?'':'g'}" onclick="setLang('en')">English</button><button class="${LANG==='te'?'':'g'}" onclick="setLang('te')">తెలుగు</button></div>`}
function setLang(l){LANG=l;try{localStorage.setItem('rythu_lang',l)}catch(e){}document.documentElement.lang=l;document.title=l==='en'?'Rythu Diary':'రైతు డైరీ – Rythu Diary';document.querySelectorAll('.m').forEach(x=>x.remove());render()}
let sentP='',db=null,base='',ST='☁️',sent={},busy=false,again=false,IC={},latest=null;
const imgs=()=>db.doc(base+'/p').collection('imgs');
function setST(t){ST=t;const e=$('#st');if(e)e.textContent=t}
async function walk(o){for(const k in o){const v=o[k];if(typeof v==='string'&&v.startsWith('data:image')){const id=uid();await imgs().doc(id).set({d:v});IC[id]=v;o[k]='i:'+id}else if(v&&typeof v==='object')await walk(v)}}
async function push(){if(!db)return;if(busy){again=true;return}busy=true;setST('☁️ సేవ్ అవుతోంది…');try{do{again=false;for(const c of [...S.crops]){const j=JSON.stringify(c);if(sent[c.id]===j)continue;const cp=JSON.parse(j);await walk(cp);await db.doc(base+'/c_'+c.id).set({crop:cp});if(JSON.stringify(c)===j){Object.keys(c).forEach(k=>delete c[k]);Object.assign(c,cp)}sent[c.id]=JSON.stringify(cp)}
if(S.profile){const pj=JSON.stringify(S.profile);if(sentP!==pj){const pc=JSON.parse(pj);await walk(pc);await db.doc(base+'/profile').set({profile:pc});if(JSON.stringify(S.profile)===pj){S.profile=pc}sentP=JSON.stringify(pc)}}else if(sentP){await db.doc(base+'/profile').delete();sentP=''}
for(const k of Object.keys(sent)){if(!S.crops.find(c=>c.id===k)){await db.doc(base+'/c_'+k).delete();delete sent[k]}}}while(again);setST('☁️ క్లౌడ్ లో సేవ్ అయింది ✅')}catch(e){setST('⚠️ క్లౌడ్ సేవ్ కాలేదు');if(e&&e.code==='quota_exceeded')alert('క్లౌడ్ స్టోరేజ్ నిండింది')}busy=false}
function sub(){unsub=db.collection(base).onSnapshot(s=>{latest=s;apply()},()=>setST('⚠️ క్లౌడ్ కనెక్ట్ కాలేదు'))}
function apply(){const snap=latest;if(!snap)return;if(busy||again||snap.metadata.hasPendingWrites||document.querySelector('.m')){setTimeout(apply,1500);return}
 const cl={};let pr=null;snap.docs.forEach(d=>{const v=d.data();if(v&&v.profile&&d.id==='profile')pr=v.profile;if(v&&v.crop&&d.id.startsWith('c_'))cl[d.id.slice(2)]=v.crop});
 const keep=S.crops.filter(c=>!cl[c.id]&&!(c.id in sent));
 sent={};for(const k in cl)sent[k]=JSON.stringify(cl[k]);
 const before=JSON.stringify([S.crops,S.profile]);if(pr){S.profile=pr;sentP=JSON.stringify(pr)}
 S.crops=Object.values(cl).concat(keep).sort((a,b)=>(b.sowDate||'').localeCompare(a.sowDate||''));
 try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}
 if(JSON.stringify([S.crops,S.profile])!==before)render();setST('☁️ క్లౌడ్ తో సింక్ అయింది ✅');if(keep.length||(!pr&&S.profile))push()}
function hydrate(){document.querySelectorAll('img[data-iid]').forEach(async im=>{const id=im.dataset.iid;try{if(!IC[id]){if(!db)return;const s=await imgs().doc(id).get();IC[id]=s.exists?s.data().d:''}if(IC[id])im.src=IC[id]}catch(e){}})}
function loginHtml(){verifier=null;return `${langBar()}<h1>🌾 రైతు డైరీ</h1><div class="card"><h2>మొబైల్ నంబర్ తో లాగిన్</h2><label>మొబైల్ నంబర్ (+91)</label><input id="mb" type="tel" inputmode="numeric" maxlength="10" placeholder="10 అంకెల నంబర్"><button id="otp">OTP పంపండి</button><div id="ob" style="display:none;margin-top:10px"><label>SMS లో వచ్చిన OTP</label><input id="ot" inputmode="numeric" maxlength="6"><button id="vf">Login</button></div><button class="g" id="gl" style="margin-top:10px">Google తో Login</button><div id="rc"></div><p class="mu" id="er"></p></div>${FB.apiKey==='PASTE'?'<div class="card"><p class="mu">Firebase ఇంకా కనెక్ట్ చేయలేదు. అప్పటివరకు ఈ ఫోన్ లో మాత్రమే వాడండి (Backup బటన్ తో ఫైల్ దాచుకోండి).</p><label>మీ పేరు</label><input id="nm"><button id="lc">ఈ ఫోన్ లో మాత్రమే వాడండి</button></div>':''}`}
let conf=null,verifier=null;
function bindLogin(){const er=m=>$('#er').textContent=m;
$('#otp').onclick=async()=>{const n=$('#mb').value.trim();if(!/^\d{10}$/.test(n))return er('సరైన 10 అంకెల నంబర్ ఇవ్వండి');try{er('');if(!verifier)verifier=new firebase.auth.RecaptchaVerifier('rc',{size:'invisible'});conf=await firebase.auth().signInWithPhoneNumber('+91'+n,verifier);$('#ob').style.display='block';er('OTP పంపాం ✅')}catch(e){er('OTP పంపలేకపోయాం: '+(e.code||e.message));try{verifier.clear()}catch(x){}verifier=null}};
$('#gl').onclick=()=>firebase.auth().signInWithPopup(new firebase.auth.GoogleAuthProvider()).catch(e=>er('Google login కాలేదు: '+(e.code||e.message)));
if($('#lc'))$('#lc').onclick=()=>{S.user={name:$('#nm').value||'రైతు',cloud:false};save();render()};
$('#vf').onclick=async()=>{try{await conf.confirm($('#ot').value.trim())}catch(e){er('OTP తప్పు')}}}
function img(file,max){return new Promise(res=>{if(!file)return res('');const r=new FileReader();r.onload=()=>{const i=new Image();i.onload=()=>{const k=Math.min(1,max/Math.max(i.width,i.height));const c=document.createElement('canvas');c.width=i.width*k;c.height=i.height*k;c.getContext('2d').drawImage(i,0,0,c.width,c.height);res(c.toDataURL('image/jpeg',.6))};i.onerror=()=>res('');i.src=r.result};r.readAsDataURL(file)})}
function stats(c){const sp=(Number(c.seedCost)||0)+c.entries.reduce((a,e)=>a+(e.type==='harvest'?0:Number(e.amount)||0),0);const inc=c.entries.reduce((a,e)=>a+(e.type==='harvest'?Number(e.amount)||0:0),0);return{sp,inc,pf:inc-sp}}

function render(){render0();hydrate();trNode($('#app'))}
function render0(){
 const a=$('#app');
 if(!S.user){a.innerHTML=loginHtml();bindLogin();return}
 if(0){a.innerHTML=`<h1>🌾 రైతు డైరీ</h1><p class="mu">మీ పంట వివరాలన్నీ ఒకే చోట – విత్తనం, మందులు, ఖర్చులు, ఫోటోలు, బిల్లులు.</p>
 <div class="card"><h2>Login</h2><label>Name / పేరు</label><input id="nm" placeholder="మీ పేరు"><label>Mobile / WhatsApp number</label><input id="mb" type="tel" inputmode="numeric" maxlength="10" placeholder="10 అంకెల నంబర్">
 <button id="otp">OTP పంపండి</button><div id="ob" style="display:none"><label>OTP (Demo: 1234)</label><input id="ot" inputmode="numeric" maxlength="4"><button id="vf">Login</button></div>
 <p class="mu">⚠️ ఇది డెమో లాగిన్. నిజమైన OTP / Google Login కోసం Firebase కనెక్ట్ చేయాలి (GitHub లో పెట్టేటప్పుడు).</p>
 <button class="g" onclick="alert('Google Login: Firebase Auth తో GitHub వెర్షన్ లో వస్తుంది')">Google తో Login (త్వరలో)</button></div>`;
  $('#otp').onclick=()=>{if(!/^\d{10}$/.test($('#mb').value))return alert('సరైన 10 అంకెల నంబర్ ఇవ్వండి');$('#ob').style.display='block'};
  $('#vf').onclick=()=>{if($('#ot').value!=='1234')return alert('OTP తప్పు (డెమో: 1234)');S.user={name:$('#nm').value||'రైతు',mobile:$('#mb').value};save();render()};
  return}
 if(cur){const c=S.crops.find(x=>x.id===cur);if(c)return crop(c);cur=null}
 home()}

function home(){
 $('#app').innerHTML=`<div class="row sp" style="flex-wrap:nowrap"><button class="g" id="mn" style="font-size:20px;padding:8px 14px">☰</button><div style="flex:1;min-width:0"><h1 style="font-size:20px;margin:0">🌾 నా పంటలు</h1><div class="mu" id="st">${S.user.cloud?ST:'📱 ఈ ఫోన్ లో మాత్రమే'}</div></div><div id="pf" class="sm" style="cursor:pointer">${avatar(S.profile)}</div></div>
 ${profCard()}${S.crops.length?S.crops.map(c=>{const s=stats(c);return `<div class="card" data-id="${c.id}" style="cursor:pointer"><div class="row sp"><h2>${esc(c.name)}</h2><span class="b">${days(c.sowDate)} రోజులు</span></div><div class="mu">విత్తిన తేదీ: ${fd(c.sowDate)} · ${c.entries.length} నమోదులు</div><div class="mu">ఖర్చు ${rs(s.sp)} · ఆదాయం ${rs(s.inc)}</div></div>`}).join(''):'<div class="card mu">ఇంకా పంట లేదు. కింద "+ కొత్త పంట" నొక్కండి. ఇప్పటికే వేసిన పంట అయితే అసలు విత్తిన తేదీ పెట్టండి – రోజులు ఆటోమేటిక్ గా లెక్కిస్తుంది.</div>'}
 <div class="mu" style="text-align:center;margin:24px 0 70px">రైతు డైరీ · వెర్షన్ 3</div>
 <button class="fab" id="ac">+ కొత్త పంట</button>`;
 document.querySelectorAll('[data-id]').forEach(e=>e.onclick=()=>{cur=e.dataset.id;tab='t';render()});
 $('#ac').onclick=()=>cropForm();$('#pf').onclick=profForm;$('#pcard').onclick=profForm;$('#mn').onclick=menu;
}
function menu(){
 const bt='style="width:100%;margin:4px 0;text-align:left"';
 const m=modal(`<h2>☰ మెనూ</h2><div class="mu">${esc(S.user.name)}</div><div class="mu">${S.user.cloud?ST:'📱 ఈ ఫోన్ లో మాత్రమే'}</div><hr style="border:0;border-top:1px solid var(--bd);margin:10px 0"><button class="g" id="m1" ${bt}>👤 నా ప్రొఫైల్</button><div class="row" style="margin:8px 0">🌐 Language <button class="${LANG==='en'?'':'g'}" id="ls1" style="padding:6px 12px">English</button><button class="${LANG==='te'?'':'g'}" id="ls2" style="padding:6px 12px">తెలుగు</button></div><button class="g" id="m2" ${bt}>💾 Backup డౌన్లోడ్</button><button class="g" id="m3" ${bt}>♻️ Restore (ఫైల్ నుండి)</button><input type="file" id="rf" accept=".json" style="display:none"><button class="g" id="m4" ${bt}>🚪 Logout</button>`);
 const d=m.firstElementChild;m.style.alignItems='stretch';m.style.justifyContent='flex-start';d.style.cssText+=';width:82%;max-width:320px;max-height:100%;height:100%;border-radius:0 18px 18px 0';
 const q=s=>m.querySelector(s);
 q('#m1').onclick=()=>{m.remove();profForm()};q('#ls1').onclick=()=>setLang('en');q('#ls2').onclick=()=>setLang('te');
 q('#m2').onclick=()=>{const b=new Blob([JSON.stringify(S)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='rythu-backup-'+today()+'.json';a.click()};
 q('#m3').onclick=()=>q('#rf').click();
 q('#rf').onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const d=JSON.parse(r.result);if(!d.crops)throw 0;const pu=S.user;S=d;S.user=pu;save();m.remove();render();alert('Restore అయింది ✅')}catch(x){alert('ఫైల్ సరైనది కాదు')}};r.readAsText(f)};
 q('#m4').onclick=()=>{const cl=S.user.cloud;if(!confirm(cl?'Logout చేయాలా? మీ డేటా క్లౌడ్ లో సురక్షితంగా ఉంటుంది, మళ్లీ లాగిన్ అయితే తిరిగి వస్తుంది.':'Logout చేయాలా? (డేటా ఈ ఫోన్ లో ఉంటుంది)'))return;m.remove();if(cl){try{firebase.auth().signOut()}catch(e){}S={user:null,crops:[]};sent={};sentP='';try{localStorage.removeItem(K)}catch(e){}render()}else{S.user=null;save();render()}};
}
function modal(html){const m=document.createElement('div');m.className='m';m.innerHTML='<div>'+html+'</div>';m.onclick=e=>{if(e.target===m)m.remove()};document.body.appendChild(m);return m}

function cropForm(cc){
 const m=modal(`<h2>కొత్త పంట / New Crop</h2><label>పంట</label><select id="cn">${CROPS.map(x=>`<option value="${x}">${x}</option>`).join('')}</select>
 <label>విత్తిన తేదీ (Sowing date) – పాత పంట అయితే అసలు తేదీ</label><input type="date" id="cd" value="${today()}"><div class="mu" id="dd"></div>
 <label>విత్తనం కంపెనీ / రకం (గుర్తులేకపోతే ఖాళీ)</label><input id="cv"><label>ఎన్ని ప్యాకెట్లు</label><input id="cp" type="number" inputmode="numeric"><label>విత్తనం మొత్తం ధర ₹</label><input id="cs" type="number" inputmode="numeric">
 <label>విత్తన ప్యాకెట్ ఫోటో</label><input type="file" id="f1" accept="image/*"><label>విత్తనం బిల్లు ఫోటో</label><input type="file" id="f2" accept="image/*">
 <div class="row"><button id="sv">Save</button><button class="g" id="cx">Cancel</button></div>`);
 const u=()=>$('.m #dd').textContent='ఇప్పటికి '+days($('.m #cd').value)+' రోజులు';u();m.querySelector('#cd').onchange=u;
 m.querySelector('#cx').onclick=()=>m.remove();
 if(cc){const g=s=>m.querySelector(s);g('#cn').value=cc.name;g('#cd').value=cc.sowDate;g('#cv').value=cc.variety||'';g('#cp').value=cc.packets||'';g('#cs').value=cc.seedCost||'';g('#dd').textContent='ఇప్పటికి '+days(cc.sowDate)+' రోజులు';g('h2').textContent='పంట వివరాలు మార్చు'}
 m.querySelector('#sv').onclick=async()=>{const q=s=>m.querySelector(s);const c={id:cc?cc.id:uid(),name:q('#cn').value,sowDate:q('#cd').value,variety:q('#cv').value,packets:q('#cp').value,seedCost:q('#cs').value,photo:await img(q('#f1').files[0],600),bill:await img(q('#f2').files[0],900),entries:cc?cc.entries:[],notes:cc?(cc.notes||[]):[]};if(cc){c.photo=c.photo||cc.photo;c.bill=c.bill||cc.bill;Object.assign(cc,c)}else S.crops.unshift(c);save();m.remove();cur=c.id;render()}}

function thumbs(arr){return arr.filter(Boolean).map(s=>s.startsWith('i:')?`<img class="t" data-iid="${s.slice(2)}" alt="…" onclick="view(this.src)">`:`<img class="t" src="${s}" onclick="view(this.src)">`).join('')}
function view(s){const m=modal(`<img src="${s}" style="width:100%;border-radius:10px"><button class="g" style="margin-top:8px">Close</button>`);m.querySelector('button').onclick=()=>m.remove()}

function crop(c){
 const s=stats(c);const es=[...c.entries].sort((a,b)=>b.date.localeCompare(a.date));
 $('#app').innerHTML=`<div class="row sp"><button class="g" id="bk">← వెనక్కి</button><button class="d" id="dl">పంట తొలగించు</button></div>
 <h1>${esc(c.name)}</h1><div class="mu">విత్తిన తేదీ ${fd(c.sowDate)} · <b>${days(c.sowDate)} రోజులు</b></div>
 <div class="card st"><div>ఖర్చు<b>${rs(s.sp)}</b></div><div>ఆదాయం<b>${rs(s.inc)}</b></div><div>లాభం<b style="color:${s.pf<0?'var(--rd)':'var(--pr)'}">${rs(s.pf)}</b></div></div>
 <div class="card"><div class="row sp"><b>🌱 విత్తనం</b><button class="g" id="ec">✏️ మార్చు</button></div><div class="mu">${esc(c.variety||'వివరాలు లేవు')} · ${esc(c.packets||'?')} ప్యాకెట్లు · ${rs(c.seedCost)}</div>${thumbs([c.photo,c.bill])}</div>
 <div class="row"><button class="${tab==='t'?'':'g'}" data-tab="t">📅 టైమ్‌లైన్</button><button class="${tab==='n'?'':'g'}" data-tab="n">📝 నోట్స్ (${(c.notes||[]).length})</button><button class="${tab==='a'?'':'g'}" data-tab="a">📊 అన్ని పనులు</button></div>${tab==='n'?notesHtml(c):tab==='a'?actHtml(c):`<div class="tl">${es.length?es.map(e=>`<div class="it"><div class="row sp"><b>${TYPES[e.type]}</b><span class="mu">${fd(e.date)} · రోజు ${days(c.sowDate)-days(e.date)}</span></div>
 ${e.title?`<div><b>${esc(e.title)}</b>${e.company?' – '+esc(e.company):''}</div>`:''}${e.detail?`<div class="mu">${esc(e.detail)}</div>`:''}
 ${e.qty?`<div class="mu">సంఖ్య/పరిమాణం: ${esc(e.qty)}</div>`:''}${e.amount?`<div>${e.type==='harvest'?'ఆదాయం':'ఖర్చు'}: <b>${rs(e.amount)}</b></div>`:''}
 ${thumbs([e.crop,e.photo,e.bill])}${resHtml(e)}${(e.type==='spray'||e.type==='fert')?`<button class="g" data-ar="${e.id}">📊 ఫలితం జోడించు</button> `:''}<button class="g" data-ee="${e.id}">✏️ మార్చు</button> <button class="d" data-del="${e.id}">తొలగించు</button></div>`).join(''):'<div class="mu">ఇంకా నమోదులు లేవు</div>'}</div>`}
 <button class="fab" id="ae">${tab==='n'?'+ నోట్':'+ నమోదు'}</button>`;
 $('#bk').onclick=()=>{cur=null;render()};
 $('#dl').onclick=()=>{if(confirm('ఈ పంట మొత్తం తొలగించాలా?')){S.crops=S.crops.filter(x=>x.id!==c.id);save();cur=null;render()}};
 $('#ae').onclick=()=>tab==='n'?noteForm(c):entryForm(c);
 $('#ec').onclick=()=>cropForm(c);
 document.querySelectorAll('[data-ee]').forEach(b=>b.onclick=()=>entryForm(c,c.entries.find(x=>x.id===b.dataset.ee)));
 document.querySelectorAll('[data-ar]').forEach(b=>b.onclick=()=>resForm(c.entries.find(x=>x.id===b.dataset.ar)));
 document.querySelectorAll('[data-rd]').forEach(b=>b.onclick=()=>{const p=b.dataset.rd.split('|');const e=c.entries.find(x=>x.id===p[0]);if(confirm('తొలగించాలా?')){e.results=e.results.filter(y=>y.id!==p[1]);save();render()}});
 document.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>{tab=b.dataset.tab;render()});
 document.querySelectorAll('[data-nd]').forEach(b=>b.onclick=()=>{if(confirm('తొలగించాలా?')){c.notes=c.notes.filter(n=>n.id!==b.dataset.nd);save();render()}});
 document.querySelectorAll('[data-ne]').forEach(b=>b.onclick=()=>noteForm(c,c.notes.find(n=>n.id===b.dataset.ne)));
 document.querySelectorAll('[data-del]').forEach(b=>b.onclick=()=>{if(confirm('తొలగించాలా?')){c.entries=c.entries.filter(e=>e.id!==b.dataset.del);save();render()}});
}

function resHtml(e){
 return (e.results||[]).map(r=>`<div style="border-left:3px solid var(--pr);padding-left:8px;margin:8px 0;background:var(--bg);border-radius:6px"><div class="row sp"><b>📊 ఫలితం: ${esc(r.rating)}</b><span class="mu">${fd(r.date)} · ${Math.round((new Date(r.date)-new Date(e.date))/864e5)} రోజుల తర్వాత</span></div>${r.text?`<div class="mu" style="white-space:pre-wrap">${esc(r.text)}</div>`:''}${thumbs([r.photo])}<button class="d" data-rd="${e.id}|${r.id}">తొలగించు</button></div>`).join('')}
function resForm(e){
 const m=modal(`<h2>📊 మందు ఫలితం</h2><div class="mu">${esc(e.title||'మందు')} · కొట్టిన తేదీ ${fd(e.date)}</div><label>ఫలితం చూసిన తేదీ</label><input type="date" id="rd" value="${today()}"><label>ఎలా పనిచేసింది?</label><select id="rr"><option value="✅ బాగా పనిచేసింది">✅ బాగా పనిచేసింది</option><option value="🟡 కొంచెం పనిచేసింది">🟡 కొంచెం పనిచేసింది</option><option value="❌ పనిచేయలేదు">❌ పనిచేయలేదు</option><option value="⚠️ పంటకు నష్టం అయింది">⚠️ పంటకు నష్టం అయింది</option></select><label>వివరాలు (తెగులు తగ్గిందా, ఎన్ని రోజుల్లో, వచ్చే సారి ఏం చేయాలి)</label><textarea id="rt" rows="4"></textarea><label>ఇప్పటి పంట ఫోటో</label><input type="file" id="f1" accept="image/*"><div class="row"><button id="sv">Save</button><button class="g" id="cx">Cancel</button></div>`);
 const q=s=>m.querySelector(s);
 q('#cx').onclick=()=>m.remove();
 q('#sv').onclick=async()=>{e.results=e.results||[];e.results.push({id:uid(),date:q('#rd').value,rating:q('#rr').value,text:q('#rt').value,photo:await img(q('#f1').files[0],700)});save();m.remove();render()}}
function actHtml(c){
 const es=[...c.entries].sort((a,b)=>a.date.localeCompare(b.date));
 const by={};es.forEach(e=>{const o=by[e.type]=by[e.type]||{n:0,t:0};o.n++;o.t+=Number(e.amount)||0});
 const rows=Object.keys(TYPES).filter(k=>by[k]).map(k=>`<tr><td>${TYPES[k]}</td><td>${by[k].n}</td><td>${rs(by[k].t)}</td></tr>`).join('');
 const med={};es.filter(e=>e.type==='spray'||e.type==='fert').forEach(e=>{const k=(e.title||'?').trim().toLowerCase();const o=med[k]=med[k]||{name:e.title||'?',d:[],r:[]};o.d.push(fd(e.date));(e.results||[]).forEach(r=>o.r.push(r.rating))});
 const ms=Object.values(med).map(o=>`<div class="card"><b>${esc(o.name)}</b> <span class="b">${o.d.length} సార్లు</span><div class="mu">${o.d.join(', ')}</div>${o.r.length?`<div>${o.r.map(esc).join(' · ')}</div>`:'<div class="mu">ఫలితం నమోదు చేయలేదు</div>'}</div>`).join('');
 const list=es.map(e=>`<div class="fl">${fd(e.date)} · రోజు ${days(c.sowDate)-days(e.date)} · ${TYPES[e.type]||''}${e.title?' · '+esc(e.title):''}${e.amount?' · '+rs(e.amount):''}</div>`).join('<br>');
 return `<div class="card"><h2>📊 రకాల వారీగా</h2>${rows?`<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse"><tr class="mu"><td>రకం</td><td>సార్లు</td><td>మొత్తం ₹</td></tr>${rows}</table></div>`:'<div class="mu">నమోదులు లేవు</div>'}</div><h2>🧪 వాడిన మందులు / ఎరువులు</h2>${ms||'<div class="card mu">ఇంకా లేవు</div>'}<h2>🗓️ అన్ని పనులు (వరుసగా)</h2><div class="card">${list||'<div class="mu">ఇంకా లేవు</div>'}</div>`}
function avatar(p){const s=p&&p.photo;return s?(s.startsWith('i:')?`<img class="av" data-iid="${s.slice(2)}" onclick="view(this.src)">`:`<img class="av" src="${s}" onclick="view(this.src)">`):'<div class="av" style="display:flex;align-items:center;justify-content:center;font-size:28px">👤</div>'}
function profCard(){const p=S.profile||{};const loc=[p.village,p.mandal,p.district].filter(Boolean).map(esc).join(', ');return `<div class="card" id="pcard" style="cursor:pointer"><b>${esc(p.name||'మీ ప్రొఫైల్ నింపండి')}</b>${p.mobile?`<div class="mu">📞 ${esc(p.mobile)}</div>`:''}${p.wa?`<div class="mu">💬 WhatsApp: ${esc(p.wa)}</div>`:''}${loc?`<div class="mu">📍 ${loc}</div>`:''}${p.name?'':'<div class="mu">ఇక్కడ నొక్కి ఫోటో, పేరు, నంబర్ నింపండి</div>'}</div>`}
function profForm(){const p=S.profile||{};
 const m=modal(`<h2>👤 రైతు ప్రొఫైల్</h2><label>ఫోటో (కెమెరా లేదా గ్యాలరీ నుండి)</label><input type="file" id="f1" accept="image/*"><label>పేరు</label><input id="p1" value="${esc(p.name)}"><label>మొబైల్ నంబర్</label><input id="p2" type="tel" inputmode="numeric" maxlength="10" value="${esc(p.mobile)}"><label>WhatsApp నంబర్ (వేరే అయితే)</label><input id="p3" type="tel" inputmode="numeric" maxlength="10" value="${esc(p.wa)}"><label>ఊరు / గ్రామం</label><input id="p4" value="${esc(p.village)}"><label>మండలం</label><input id="p5" value="${esc(p.mandal)}"><label>జిల్లా</label><input id="p6" value="${esc(p.district)}"><div class="row"><button id="sv">Save</button><button class="g" id="cx">Cancel</button></div>`);
 const q=s=>m.querySelector(s);
 q('#cx').onclick=()=>m.remove();
 q('#sv').onclick=async()=>{const mb=q('#p2').value.trim();if(!q('#p1').value.trim())return alert('పేరు ఇవ్వండి');if(!/^\d{10}$/.test(mb))return alert('మొబైల్ నంబర్ 10 అంకెలు ఇవ్వండి');const ph=await img(q('#f1').files[0],500);S.profile={name:q('#p1').value.trim(),mobile:mb,wa:q('#p3').value.trim(),village:q('#p4').value.trim(),mandal:q('#p5').value.trim(),district:q('#p6').value.trim(),photo:ph||p.photo||''};save();m.remove();render()}}
function notesHtml(c){
 const ns=[...(c.notes||[])].sort((a,b)=>b.date.localeCompare(a.date));
 return ns.length?ns.map(n=>`<div class="card"><div class="row sp"><b>${esc(n.title||'నోట్')}</b><span class="mu">${fd(n.date)}</span></div><div style="white-space:pre-wrap;margin:6px 0">${esc(n.text)}</div>${thumbs([n.photo])}<div class="row"><button class="g" data-ne="${n.id}">✏️ మార్చు</button><button class="d" data-nd="${n.id}">తొలగించు</button></div></div>`).join(''):'<div class="card mu">నోట్స్ లేవు. ఉదా: "ఈ మందు బాగా పనిచేసింది", "ఈ ఎరువు వద్దు", "వచ్చే ఏడాది ఇది చేయాలి" – "+ నోట్" నొక్కి రాయండి.</div>'}
function noteForm(c,n){
 const m=modal(`<h2>${n?'నోట్ మార్చు':'కొత్త నోట్'}</h2><label>తేదీ</label><input type="date" id="nd" value="${n?n.date:today()}"><label>శీర్షిక (ఉదా: మందు పేరు / విషయం)</label><input id="nt" value="${esc(n?n.title:'')}"><label>నోట్ (ఏ మందు ఎందుకు వాడాం, ఫలితం, వచ్చే ఏడాది గుర్తుంచుకోవాల్సినవి)</label><textarea id="nx" rows="6">${esc(n?n.text:'')}</textarea><label>ఫోటో (ఐచ్ఛికం)</label><input type="file" id="f1" accept="image/*"><div class="row"><button id="sv">Save</button><button class="g" id="cx">Cancel</button></div>`);
 const q=s=>m.querySelector(s);
 q('#cx').onclick=()=>m.remove();
 q('#sv').onclick=async()=>{if(!q('#nx').value.trim()&&!q('#nt').value.trim())return alert('ఏదైనా రాయండి');c.notes=c.notes||[];const p=await img(q('#f1').files[0],600);const o={id:n?n.id:uid(),date:q('#nd').value,title:q('#nt').value,text:q('#nx').value,photo:p||(n?n.photo:'')};if(n)Object.assign(n,o);else c.notes.push(o);save();m.remove();tab='n';render()}}
function entryForm(c,ed){
 const m=modal(`<h2>కొత్త నమోదు</h2><label>రకం</label><select id="et">${Object.entries(TYPES).filter(([k])=>k!=='note').map(([k,v])=>`<option value="${k}">${v}</option>`).join('')}</select>
 <label>తేదీ (పాత తేదీ కూడా పెట్టొచ్చు)</label><input type="date" id="ed" value="${today()}">
 <label id="l1">మందు / వస్తువు పేరు</label><input id="e1" list="ex"><datalist id="ex">${EXP.map(x=>`<option value="${tr(x)}">`).join('')}</datalist>
 <label>కంపెనీ</label><input id="e2"><label id="l3">ఎందుకు వాడాం / ఏ తెగులు కోసం / ఫలితం, నోట్స్</label><textarea id="e3" rows="3"></textarea>
 <label id="l4">పరిమాణం (ఎన్ని మొక్కలు / లీటర్లు / క్వింటాళ్లు)</label><input id="e4">
 <label id="l5">ఖర్చు ₹</label><input id="e5" type="number" inputmode="numeric">
 <label>🧪 మందు / బాటిల్ ఫోటో</label><input type="file" id="f1" accept="image/*"><label>🌿 పంట / మొక్క ఫోటో (మందు కొట్టినప్పుడు పంట ఎలా ఉందో)</label><input type="file" id="f3" accept="image/*"><label>బిల్ ఫోటో</label><input type="file" id="f2" accept="image/*">
 <div class="row"><button id="sv">Save</button><button class="g" id="cx">Cancel</button></div>`);
 const q=s=>m.querySelector(s);
 q('#et').onchange=()=>{const t=q('#et').value;q('#l5').textContent=t==='harvest'?'ఆదాయం ₹ (అమ్మిన మొత్తం)':'ఖర్చు ₹';q('#l1').textContent=t==='replant'?'ఏ మొక్కలు కొన్నారు':t==='harvest'?'ఎక్కడ అమ్మారు':'మందు / వస్తువు పేరు'};
 q('#cx').onclick=()=>m.remove();
 if(ed){q('#et').value=ed.type;q('#ed').value=ed.date;q('#e1').value=ed.title||'';q('#e2').value=ed.company||'';q('#e3').value=ed.detail||'';q('#e4').value=ed.qty||'';q('#e5').value=ed.amount||'';q('#et').onchange();m.querySelector('h2').textContent='నమోదు మార్చు'}
 q('#sv').onclick=async()=>{const o=({id:ed?ed.id:uid(),results:ed?ed.results:undefined,type:q('#et').value,date:q('#ed').value,title:q('#e1').value,company:q('#e2').value,detail:q('#e3').value,qty:q('#e4').value,amount:q('#e5').value,crop:await img(q('#f3').files[0],700),photo:await img(q('#f1').files[0],600),bill:await img(q('#f2').files[0],900)});if(ed){o.crop=o.crop||ed.crop;o.photo=o.photo||ed.photo;o.bill=o.bill||ed.bill;Object.assign(ed,o)}else c.entries.push(o);save();m.remove();render()}}
const FB={apiKey:"AIzaSyCGIbxg5a7djLTU_9xShR1Nb2yVKQfli1s",authDomain:"rythu-diary.firebaseapp.com",projectId:"rythu-diary",appId:"1:11631828922:web:3c892f4c854805ae138783"};
let fs=null;
try{firebase.initializeApp(FB);fs=firebase.firestore()}catch(e){}
const dref=p=>({get:async()=>{const x=await fs.doc(p).get();return{exists:x.exists,data:()=>x.data()}},set:d=>fs.doc(p).set(d),delete:()=>fs.doc(p).delete(),collection:q=>cref(p+'/'+q)});
const cref=p=>({doc:id=>dref(p+'/'+id),onSnapshot:(n,e)=>fs.collection(p).onSnapshot({includeMetadataChanges:true},x=>n({docs:x.docs.map(d=>({id:d.id,data:()=>d.data()})),metadata:{hasPendingWrites:x.metadata.hasPendingWrites}}),e)});
const fsDb={doc:dref,collection:cref};
let unsub=null;
S.user=null;render();
try{firebase.auth().onAuthStateChanged(u=>{if(unsub){try{unsub()}catch(e){}unsub=null}
 if(u){db=fsDb;base='data/users/'+u.uid;S.user={name:u.phoneNumber||u.email||'రైతు',cloud:true};render();sub()}
 else{db=null;S.user=null;render()}})}catch(e){}
</script>
</body>
</html>
